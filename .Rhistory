Consume = 0,
Consume_Time = sum(time_step_lengths),
Storage_Data = hydrodata,
start_date = start_date
)
last_inflow_proj <- fPowellGameDataWrangle(
Inflow = c(0,0,0, inflow),
Inflow_Time = time_step_lengths,
Release = 0,
Release_Time = sum(time_step_lengths),
Add_Release = 0,
Add_Time = sum(time_step_lengths),
Consume = 0,
Consume_Time = sum(time_step_lengths),
Storage_Data = hydrodata,
start_date = start_date
)
#Inflow scenario set up
possible_inflows <- c(4.839, 5.142, 5.520, 5.934)
inflow <- sample(possible_inflows, 1)
#UB consumptive use set up, 4.47 is upper basin consumptive use in 2024
# inflow during last time step is maximum consumption, if last inflow is higher than the historical consumption (4.47 MAF), choose historical
ub_use <- reactiveVal(numeric(length(time_step_lengths)))
last_inflow_proj <- fPowellGameDataWrangle(
Inflow = c(0,0,0, inflow),
Inflow_Time = time_step_lengths,
Release = 0,
Release_Time = sum(time_step_lengths),
Add_Release = 0,
Add_Time = sum(time_step_lengths),
Consume = 0,
Consume_Time = sum(time_step_lengths),
Storage_Data = hydrodata,
start_date = start_date
)
View(last_inflow_proj)
last_inflow <- sum(last_inflow_proj$inflow[last_inflow_proj$label == "No Additional Release"]) / 1000000
